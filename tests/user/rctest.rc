# tests/user/rctest.rc: M4's exit test, the shell's part (tests/qemu/rcscript.ndb).
# rc runs it in the POSIX userland: sbase's commands from /bin, files in /tmp.
# Each check compares a command's output with what it should be; the last line
# counts them; the script's exit status is empty, rc's success, or says how
# many failed.

checks=0
failed=0

# check NAME WANT GOT...: GOT's words, joined, should be WANT.
fn check {
  checks=`{expr $checks + 1}
  name=$1
  want=$2
  shift 2
  if(! ~ $"* $want) {
    failed=`{expr $failed + 1}
    echo 'rctest: FAILED' $name: wanted $want, got $"*
  }
}

echo 'rctest: rc in the POSIX userland, args' $*

# Arguments and the environment.
check args 'one two words' $*
check argc 2 $#*
check env /tmp $HOME
check exported 'a b' `{env | grep '^LIST=' | sed 's/^LIST=//' | tr '\001' ' '}

# Pipelines through sbase's text tools.
check pipe 3 `{printf 'c\nb\na\n' | sort | wc -l}
check sort 'a b c' `{printf 'c\nb\na\n' | sort}
check uniq 'a b' `{printf 'a\na\nb\n' | uniq}
check tr HELLO `{echo hello | tr a-z A-Z}
check sed 'hi there' `{echo hello there | sed 's/hello/hi/'}
check cut b `{echo a:b:c | cut -d: -f2}
check head '1 2' `{seq 1 10 | head -n 2}
check tail '9 10' `{seq 1 10 | tail -n 2}
check grep 'apple apricot' `{printf 'apple\nbanana\napricot\n' | grep '^ap'}
check long 5 `{seq 1 2000 | grep 7 | sort -n | tail -n 1 | wc -c}

# Redirections: into files in /tmp, appended, read back, errors aside.
dir=/tmp/rctest
mkdir -p $dir
echo first > $dir/f
echo second >> $dir/f
check redirect 'first second' `{cat < $dir/f}
check count 2 `{wc -l < $dir/f}
ls /nonexistent >[2] $dir/err
check stderr-status false `{if(~ $status '') echo true; if not echo false}
check stderr-file 1 `{wc -l < $dir/err}
{ echo one; echo two } > $dir/g
check block 'one two' `{cat $dir/g}
echo both >[2=1] > $dir/h
check dup both `{cat $dir/h}

# Globbing, in sorted order, and a pattern that matches nothing kept.
for(n in c a b) touch $dir/$n.x
check glob 'a.x b.x c.x' `{for(f in $dir/*.x) basename $f}
check noglob $dir/'*.y' $dir/*.y

# Control flow: loops, conditions, switch, functions with $*.
total=0
for(i in `{seq 1 5}) total=`{expr $total + $i}
check for 15 $total
n=0
while(test $n -lt 3) n=`{expr $n + 1}
check while 3 $n
fn kind {
  switch($1){
  case *.c *.h
    echo source
  case *.rc
    echo script
  case *
    echo other
  }
}
check switch 'source script other' `{kind a.c} `{kind t.rc} `{kind x}
fn count { echo $#* }
check fn-args 3 `{count a 'b c' d}
check and-or 'yes no' `{test -d $dir && echo yes} `{test -f $dir/none || echo no}
check not ok `{if(! test -f $dir/none) echo ok}
check status 'file does not exist' `{nosuchcommand >[2] /dev/null; echo $status}
check pipe-status ok `{false | true; if(~ $status 'false '*': 1|') echo ok}
check pipe-true yes `{if(true | true) echo yes; if not echo no}
printf 'c\nb\na\n' > $dir/unsorted
sort < $dir/unsorted | uniq > $dir/sorted
check pipe-files 'a b c' `{cat $dir/sorted}
check pipe-dup 1 `{ls $dir/none >[2=1] | wc -l}
check big-args 300 `{count `{seq 1 300}}
check big-spawn 300 `{echo `{seq 1 300} | wc -w}

# A script calling a script: rc itself, with arguments.
echo 'echo $#* $2' > $dir/inner.rc
check nested '2 b' `{rc $dir/inner.rc a b}

# The current directory (6d7a, ADR-0039): cd, a relative name after each
# change, and children, sbase's and native, starting in it.
check wd-start / `{pwd}
check cdtest '24 checks, 0 failed' `{/boot/bin/cdtest | sed -n 's/^cdtest: //p'} # from C, a child of this shell's
check wd-start-native / `{/boot/bin/pwd}
cd $dir
check cd $dir `{pwd}
check cd-native $dir `{/boot/bin/pwd}
echo hello > rel
check rel-sbase hello `{cat rel}
check rel-native hello `{/boot/bin/cat rel}
check rel-glob rel `{echo re?}
mkdir sub
cd sub
check cd-rel $dir/sub `{pwd}
cd ..
check cd-dotdot $dir `{pwd}
cd rel >[2] /dev/null
check cd-file 'can''t cd' $status
check cd-file-left $dir `{pwd}
cd no-such-dir >[2] /dev/null
check cd-missing 'can''t cd' $status
cdpath=(/nowhere /boot)
cd bin >[2] /dev/null
check cdpath /boot/bin `{pwd}
cdpath=()
home=$dir
cd
check cd-home $dir `{pwd}
cd /
check cd-root / `{pwd}

# Code run in a child (6d7b1), as 9front's rc forks for it: a child rc, given
# this shell's variables, functions, namespace and directory.
fn twice { echo $1; echo $1 }
check fn-stage 2 `{twice x | wc -l}
check block-stage 3 `{{echo a; echo b; echo c} | wc -l}
check block-middle 'HI THERE' `{echo hi | {cat; echo there} | tr a-z A-Z}
x=outer
@{x=inner; cd /boot}
check subshell-var outer $x
check subshell-cd / `{pwd}
y=`{x=inner; cd /boot; pwd}
check backq-var outer $x
check backq-cd '/boot /' $y `{pwd}
check backq-cd-child /boot `{cd /boot; /boot/bin/pwd}
{echo bg $x > $dir/bg} &
wait
check block-async 'bg outer' `{cat $dir/bg}
fn bgfn { echo fn $1 > $dir/bgfn }
bgfn z &
wait
check fn-async 'fn z' `{cat $dir/bgfn}
check child-status ok `{{exit 7} | true; if(~ $status 'rc '*': 7|') echo ok; if not echo $status}
check child-local 'L q' `{fn inner { {echo $1 $x} | cat }; x=q inner L}

# Descriptors past 2 and /fd (6d7b2, ADR-0040); <{...} and >{...} on them,
# as 9front's rc has them.
check fd3-sbase 'first second' `{cat /fd/3 <[3] $dir/f}
check fd3-native 'first second' `{/boot/bin/cat /fd/3 <[3] $dir/f}
check fd0-native 'first second' `{/boot/bin/cat /fd/0 < $dir/f}
{true; /boot/bin/true; cat <[0=3] > $dir/f3} <[3] $dir/f
check fd3-untouched 'first second' `{cat $dir/f3} # programs that never read 3 take nothing from it
echo three | tee /fd/3 >[3] $dir/three > /dev/null
check fd3-write three `{cat $dir/three}
check pipefd-words '/fd/3 /fd/4' `{echo <{true} <{true}}
check pipefd-sbase hi `{cat <{echo hi}}
check pipefd-native hi `{/boot/bin/cat <{echo hi}}
check pipefd-two 'a b' `{paste <{echo a} <{echo b}}
check pipefd-cmp same `{cmp <{echo x} <{echo x} && echo same}
check pipefd-differ differ `{cmp -s <{echo x} <{echo y} || echo differ}
check pipefd-state 'outer z' `{fn st { cat <{echo $x $1} }; st z}
echo written | tee >{cat > $dir/teed} > /dev/null
wait
check pipefd-write written `{cat $dir/teed}

# A command run with & that has ended keeps its status until wait takes it,
# however many commands came between (the Rust port's finding).
{exit 3} &
bg=$apid
/boot/bin/true
/boot/bin/true
wait $bg
check bg-wait ok `{if(~ $status *': 3') echo ok; if not echo $status}

# 6d7c: a #! script run by its interpreter, given the line's arguments, the
# script's path and its own; a command with a file redirected, run with &;
# -v not echoing rcmain, which rc reads with . -q.
echo '#!/boot/bin/echo hello' > $dir/hi
check shebang 'hello '$dir'/hi a b' `{$dir/hi a b}
echo '#!/boot/bin/rc' > $dir/sc.rc
echo 'echo script $#* $1' >> $dir/sc.rc
check shebang-rc 'script 2 x' `{$dir/sc.rc x y}
echo bgfile > $dir/bgf &
wait
check bg-redirect bgfile `{cat $dir/bgf}
rc -v -c 'echo x' >[2] $dir/v > /dev/null
check v-quiet '0 1' `{grep -c 'flag p' $dir/v; grep -c 'echo x' $dir/v}

# rfork (6d7b3), as 9front's: in children, so this shell keeps its own.
check rfork-usage 'rfork usage' `{rfork x >[2] /dev/null; echo $status}
mkdir $dir/nsa $dir/nsb
@{bind /boot/bin $dir/nsa}
check rfork-shared yes `{if(test -e $dir/nsa/echo) echo yes; if not echo no} # a child's bind: the group's
unmount $dir/nsa
@{rfork n; bind /boot/bin $dir/nsb; if(test -e $dir/nsb/echo) echo seen > $dir/seen}
check rfork-n-own seen `{cat $dir/seen}
check rfork-n-private no `{if(test -e $dir/nsb/echo) echo yes; if not echo no}
@{rfork N; /boot/bin/true} >[2] /dev/null
check rfork-N-clean ok `{if(~ $status *'file does not exist') echo ok; if not echo $status}
check rfork-m refused `{rfork m; mount /srv/nsd $dir/nsb >[2] /dev/null; if(! ~ $status '') echo refused}
check rfork-m-child refused `{rfork m; rc -c 'mount /srv/nsd '$dir'/nsb >[2] /dev/null; if(! ~ $status '''') echo refused'} # and its children
check rfork-s '' `{rfork s; echo $status}
check rfork-ens '' `{rfork; echo $status}

rm -r $dir
check cleaned no `{if(test -d $dir) echo yes; if not echo no}

echo rctest: $checks checks, $failed failed
if(~ $failed 0) exit # an empty status: success, as rc's
exit $failed^' failed'
