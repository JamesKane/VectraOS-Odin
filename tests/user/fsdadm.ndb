# tests/user/fsdadm.ndb: gsh runs /boot/tests/fsdadm.rc as vectra, with fsd's
# home branch on /tmp, its adm branch on /adm, and home permissively on /n
# (tests/qemu/fsdadm.ndb).

service=fsdadm program=/boot/bin/gsh console entropy
user=vectra
arg=/boot/tests/fsdadm.rc
ns=posix
mount=/tmp srv=fsd aname=home flags=c
mount=/adm srv=fsd aname=adm
mount=/n srv=fsd aname=%home
connect=nsd
env=PATH=/bin
env=HOME=/tmp
