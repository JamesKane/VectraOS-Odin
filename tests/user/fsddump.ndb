# tests/user/fsddump.ndb: gsh runs /boot/tests/fsddump.rc as vectra, with fsd's
# home branch on /tmp, its adm branch on /adm and its dump view on /n
# (tests/qemu/fsddump.ndb).

service=fsddump program=/boot/bin/gsh console entropy
user=vectra
arg=/boot/tests/fsddump.rc
ns=posix
mount=/tmp srv=fsd aname=home flags=c
mount=/adm srv=fsd aname=adm
mount=/n srv=fsd aname=dump
connect=nsd
env=PATH=/bin
env=HOME=/tmp
