# tests/user/fsdnone.rc: fsd's permissions as none sees them (tests/qemu/fsd.ndb).
# rc runs it as user none, with fsd's home branch on /tmp: none gets only
# other's bits, so it reads what anyone may and is refused what only the owner
# may, and adm's ctl refuses it. The last line counts the checks.

checks=0
failed=0

fn check {
  checks=`{expr $checks + 1}
  name=$1
  want=$2
  shift 2
  if(! ~ $"* $want) {
    failed=`{expr $failed + 1}
    echo 'fsdnone: FAILED' $name: wanted $want, got $"*
  }
}

check read 'hello from a vx-fs volume' `{cat /tmp/hello.txt}
check list 'docs greeting hello.txt' `{ls /tmp | sort}
if(touch /tmp/none-was-here >[2]/dev/null) r=written
if not r=refused
check create refused $r
if(rm /tmp/hello.txt </dev/null >[2]/dev/null) r=removed # no terminal: rm asks before removing a file access(2) says it may not write
if not r=refused
check remove refused $r
check still 'hello from a vx-fs volume' `{cat /tmp/hello.txt}
if(echo sync | tee /adm/ctl >/dev/null >[2]/dev/null) r=obeyed
if not r=refused
check ctl refused $r

# test(1)'s -r, -w and -x ask access(2), which asks fsd by opening (6d9a):
# none may read hello.txt and search the root, and write neither.
fn t { if(test $1 $2) echo yes; if not echo no }
check test-r yes `{t -r /tmp/hello.txt}
check test-w no `{t -w /tmp/hello.txt}
check test-x no `{t -x /tmp/hello.txt}
check test-dir 'yes no yes' `{t -r /tmp} `{t -w /tmp} `{t -x /tmp}

echo 'fsdnone:' $checks checks, $failed failed
if(~ $failed 0) exit # an empty status: success, as rc's
exit $failed^' failed'
