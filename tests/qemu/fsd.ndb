# tests/qemu/fsd.ndb: fsd, the system volume's file server (M5 step 4). The
# second disk's system partition is a vx-fs volume ./build made (volume=:
# its home branch from tests/fsd/home); partd serves the partition, fsd
# mounts the volume and serves it, and ctest's checks run with /tmp on fsd
# (tests/user/ctestfsd.ndb), reading first a file the build put there.
# fsdperm.ndb checks what fsd refuses.

scenario=fsd timeout=90 cmdline=vx.skip=gsh with=ctestfsd,fsdvol disk=64 volume=tests/fsd/home
expect="partd: /srv/disk1: 2 partitions"
expect="fsd: /srv/disk1.vectra: commit "
expect="fsd: serving /srv/fsd"
expect="ctest: /tmp/hello.txt: hello from a vx-fs volume"
expect=" checks, 0 failed"
line="svcd: ctestfsd exited"
fail="vx: panic"
fail="svcd: ctestfsd exited: "
fail="fsd: FAILED"
fail="not implemented"
fail="FAILED"
fail=") killed: "
