# tests/qemu/fsdnvmerestart.ndb: a disk driver restarted under I/O load (M5
# step 6e). As fsdnvme, but drv-nvme exits after 100 completions, on its first
# start (drv-nvme.die=100), with commands in flight, as a crash would. devmgr
# revokes its DMA domain, turns off bus mastering, resets the function if it
# can, and starts it again; fsd's session goes, and its block client dials
# again through partd and does again what it was waiting for. ctest's checks
# all pass, and fsd's commits with them.

scenario=fsdnvmerestart timeout=120 cmdline="vx.skip=gsh drv-nvme.die=100" with=ctestfsd,fsdvol disk=64 bus=nvme volume=tests/fsd/home
expect="drv-nvme: 64 MiB, 512-byte sectors"
expect="partd: /srv/disk1: 2 partitions"
expect="fsd: /srv/disk1.vectra: commit "
expect="fsd: serving /srv/fsd"
expect="ctest: /tmp/hello.txt: hello from a vx-fs volume"
expect="drv-nvme: exiting, as asked (drv-nvme.die)"
expect="drv-nvme exited: drv-nvme.die"
expect="drv-nvme: 64 MiB"
expect="vx-blk: the disk's session went; dialled again"
expect=" checks, 0 failed"
line="svcd: ctestfsd exited"
fail="vx: panic"
fail="svcd: ctestfsd exited: "
fail="fsd: FAILED"
fail="not implemented"
fail="FAILED"
fail=") killed: "
