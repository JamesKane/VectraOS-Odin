# tests/qemu/fsdperm.ndb: fsd's permissions (M5 step 4b1). The fsd scenario's
# volume (tests/user/fsdvol.ndb), and a script run as user none
# (tests/user/fsdnone.rc): none gets only other's bits, so fsd lets it read
# what anyone may and refuses it the rest.

scenario=fsdperm timeout=60 cmdline=vx.skip=gsh with=fsdnone,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="fsdnone: 6 checks, 0 failed"
line="svcd: fsdnone exited"
fail="vx: panic"
fail="fsdnone: FAILED"
fail="svcd: fsdnone exited: "
fail="fsd: FAILED"
fail=") killed: "
