# tests/qemu/fsdadm.ndb: fsd's adm files and permissive attaches (M5 step
# 4b2). The fsd scenarios' volume (tests/user/fsdvol.ndb), and a script run as
# vectra (tests/user/fsdadm.rc) that gives every ctl command, reads status
# back, reads through %home what /tmp refuses, rolls home back and halts.

scenario=fsdadm timeout=90 cmdline=vx.skip=gsh with=fsdadm,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="fsdadm: 23 checks, 0 failed"
line="svcd: fsdadm exited"
fail="vx: panic"
fail="fsdadm: FAILED"
fail="svcd: fsdadm exited: "
fail="fsd: FAILED"
fail=") killed: "
