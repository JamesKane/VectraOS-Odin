# tests/qemu/fsdnvmereset.ndb: drv-nvme's recovery (M5 step 6a). As fsdnvme,
# but the driver resets the controller after every 50 completions
# (drv-nvme.reset=50 on the command line), with commands in flight: each is
# submitted again, so fsd and ctest see delays, never errors.

scenario=fsdnvmereset timeout=120 cmdline="vx.skip=gsh drv-nvme.reset=50" with=ctestfsd,fsdvol disk=64 bus=nvme volume=tests/fsd/home
expect="drv-nvme: 64 MiB, 512-byte sectors"
expect="partd: /srv/disk1: 2 partitions"
expect="fsd: /srv/disk1.vectra: commit "
expect="fsd: serving /srv/fsd"
expect="ctest: /tmp/hello.txt: hello from a vx-fs volume"
expect="drv-nvme: reset: drv-nvme.reset"
expect=" checks, 0 failed"
line="svcd: ctestfsd exited"
fail="vx: panic"
fail="svcd: ctestfsd exited: "
fail="fsd: FAILED"
fail="not implemented"
fail="FAILED"
fail=") killed: "
