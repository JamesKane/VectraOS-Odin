# tests/qemu/maptest.ndb: a mapped file on fsd across a snapshot, a rollback,
# the dump view, and a commit read through a second attach (M5 step 10;
# tests/posix/maptest.c).

scenario=maptest timeout=60 cmdline=vx.skip=gsh with=maptest,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="maptest: 15 checks, 0 failed"
line="svcd: maptest exited"
fail="vx: panic"
fail="maptest: FAILED"
fail="svcd: maptest exited: "
fail="fsd: FAILED"
fail=") killed: "
