# tests/qemu/fsdnvme.ndb: drv-nvme (M5 step 6a). The fsd scenario with its
# second disk on QEMU's NVMe controller rather than virtio-blk: partd, fsd and
# ctest's checks (mmap and dref among them) over drv-nvme.

scenario=fsdnvme timeout=90 cmdline=vx.skip=gsh with=ctestfsd,fsdvol disk=64 bus=nvme volume=tests/fsd/home
expect="drv-nvme: 64 MiB, 512-byte sectors"
expect="partd: /srv/disk1: 2 partitions"
expect="fsd: /srv/disk1.vectra: commit "
expect="fsd: serving /srv/fsd"
expect="ctest: /tmp/hello.txt: hello from a vx-fs volume"
expect=" checks, 0 failed"
line="svcd: ctestfsd exited"
fail="vx: panic"
fail="svcd: ctestfsd exited: "
fail="fsd: FAILED"
fail="not implemented"
fail="FAILED"
fail=") killed: "
