# tests/qemu/panic.ndb: a kernel fault reaches the panic handler, which names
# the fault and prints a symbolized backtrace (M1). The backtrace ends where
# CPU 0 left the boot stack for a kernel stack (mm/kstack.c).

scenario=panic timeout=10 cmdline=vx.selftest=fault
expect="vx: kernel 0.1.0 $arch, "
expect="vx: panic: page fault at "
expect=" kernel_main_on_kstack+"
