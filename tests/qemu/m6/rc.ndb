# tests/qemu/rc.ndb: the shell's language as Plan 9 rc's (M4 step 7a; rc's
# start, -c and -x, rcmain's $path and $home, and a here document typed at the
# prompt, M6 step 6a6b; whatis, a function exported to a child, exec, wait and
# sigexit, step 6a6c), in the running
# system: lists, ^, control flow, functions, `{...} from a program, redirections
# into tmpfs and back, globbing through the namespace, a construct continued
# over lines, and a script run with arguments, `rc FILE ARG ...`.

scenario=rc timeout=30
expect="svcd: started rc (task "
prompt="% "
send="x=(a b c); echo $#x $x(2) pre^$x"
line="3 b prea preb prec"
prompt="% "
send="for(i in 1 2) { if(~ $i 2) echo two; if not echo not $i }"
line="not 1"
line="two"
prompt="% "
send="fn greet { echo hello $1 }; greet world"
line="hello world"
prompt="% "
send="names=`{ls /}; echo $#names $names(1)"
line="15 adm"
prompt="% "
send="echo one > /tmp/a.x; echo two >> /tmp/a.x; echo three > /tmp/b.x; cat < /tmp/a.x"
line="one"
line="two"
prompt="% "
send="echo /tmp/*.x; echo '/tmp/*.x'"
line="/tmp/a.x /tmp/b.x"
line="/tmp/*.x"
prompt="% "
send="switch(`{cat /tmp/b.x}){"
send="case one; echo first"
send="case t*; echo matched t"
send="}"
expect="matched t"
prompt="% "
send="echo 'for(a in $*) echo arg $a' > /tmp/t.rc; echo 'exit $#*' >> /tmp/t.rc"
prompt="% "
send="rc /tmp/t.rc x 'y z'; if(~ $status 'rc '*': 2') echo status 2"
line="arg x"
line="arg y z"
line="status 2"
prompt="% "
send="ls /nothing | tail -1 || if(~ $status 'ls '*': error|') echo failed error"
line="failed error"
prompt="% "
send="nosuch; echo $status"
expect="nosuch: file does not exist"
line="file does not exist"
prompt="% "
send="rc -c 'echo from -c'"
line="from -c"
prompt="% "
send="rc -x -c 'echo traced'"
line="echo traced"
line="traced"
prompt="% "
send="echo $path $home; ~ $pid [0-9]* && echo pid"
line="/bin . /"
line="pid"
prompt="% "
send="cat <<EOF"
send="here $home"
send="EOF"
expect="here /"
prompt="% "
send="fn greet {echo hello $1}; whatis greet; rc -c 'greet bob'"
line="fn greet {"
expect="echo hello $1"
line="}"
line="hello bob"
prompt="% "
send="rc -c 'exec echo replaced'; echo $status"
line="replaced"
prompt="% "
send="echo background &; wait; echo waited"
expect="waited"
prompt="% "
send="rc -c 'fn sigexit {echo bye}; echo hi'"
line="hi"
line="bye"
prompt="% "
send="m=`{ns}; echo $user; if(~ $m /home) echo home mounted; if not echo no home"
line="none"
line="no home"
fail="vx: panic"
fail="FAILED"
fail="syntax error"
fail="cannot"
