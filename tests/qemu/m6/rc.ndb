# tests/qemu/rc.ndb: the shell's language as Plan 9 rc's (M4 step 7a), in the running
# system: lists, ^, control flow, functions, `{...} from a program, redirections
# into tmpfs and back, globbing through the namespace, a construct continued
# over lines, and a script run with arguments, `rc FILE ARG ...`.

scenario=rc timeout=30
expect="svcd: started rc (task "
prompt="vx% "
send="x=(a b c); echo $#x $x(2) pre^$x"
line="3 b prea preb prec"
prompt="vx% "
send="for(i in 1 2) { if(~ $i 2) echo two; if not echo not $i }"
line="not 1"
line="two"
prompt="vx% "
send="fn greet { echo hello $1 }; greet world"
line="hello world"
prompt="vx% "
send="names=`{ls /}; echo $#names $names(1)"
line="12 adm"
prompt="vx% "
send="echo one > /tmp/a.x; echo two >> /tmp/a.x; echo three > /tmp/b.x; cat < /tmp/a.x"
line="one"
line="two"
prompt="vx% "
send="echo /tmp/*.x; echo '/tmp/*.x'"
line="/tmp/a.x /tmp/b.x"
line="/tmp/*.x"
prompt="vx% "
send="switch(`{cat /tmp/b.x}){"
send="case one; echo first"
send="case t*; echo matched t"
send="}"
expect="matched t"
prompt="vx% "
send="echo 'for(a in $*) echo arg $a' > /tmp/t.rc; echo 'exit $#*' >> /tmp/t.rc"
prompt="vx% "
send="rc /tmp/t.rc x 'y z'; if(~ $status 'rc '*': 2') echo status 2"
line="arg x"
line="arg y z"
line="status 2"
prompt="vx% "
send="ls /nothing | tail -1 || if(~ $status 'ls '*': error|') echo failed error"
line="failed error"
prompt="vx% "
send="nosuch; echo $status"
expect="nosuch: file does not exist"
line="file does not exist"
fail="vx: panic"
fail="FAILED"
fail="syntax error"
fail="cannot"
