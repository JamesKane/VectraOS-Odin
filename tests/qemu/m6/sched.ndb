# tests/qemu/sched.ndb: scheduling contexts (M6 step 6d6c, ADR-0038): a
# realtime context's share kept, and capped, under 32 busy threads; a
# reserved CPU kept by the thread bound to it; admission past 80% of the CPUs
# and a reservation of the shared CPU refused (tests/user/schedtest.c).

scenario=sched timeout=120 cmdline=vx.skip=rc,netd with=schedtest
expect="schedtest: realtime against a hog"
expect="schedtest: reserved against a hog"
expect="schedtest: back-to-back calls answered"
line="svcd: schedtest exited"
fail="vx: panic"
fail="schedtest: FAILED"
fail="svcd: schedtest exited: "
fail=") killed: "
