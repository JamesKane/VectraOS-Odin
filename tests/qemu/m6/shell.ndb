# tests/qemu/shell.ndb: M2's exit test (docs/04 §5): a shell in a namespace,
# commands in their own namespaces, /proc, pipes, and a console driver killed
# from the shell and restarted by svcd, after which the shell carries on; and
# $status, each command's wait message (name pid: exit string) joined by |,
# as 9front's rc keeps it (ADR-0010, M6 step 6a6a).

scenario=shell timeout=30
expect="svcd: started rc (task "
prompt="% "
send="ls /"
line="adm  bin  boot  dev  dist  lib  n  net  proc  rc  srv  sys  tmp"
prompt="% "
send="cat /proc/1/status"
expect="name=svcd state=waiting threads=1 mem="
prompt="% "
send="bind -a /boot/bin /bin; ns | tail -1"
line="bind -a /boot/bin /bin"
prompt="% "
send="ps"
expect="name=procfs state="
prompt="% "
send="uartpid=2; echo kill > /proc/$uartpid/ctl"
expect="svcd: started uart (task "
expect="svcd: uart exited: killed"
prompt="% "
send="echo still here"
line="still here"
prompt="% "
send="ls /nothing | tail -1; if(~ $status 'ls '*': error|') echo status ok"
expect="ls: /nothing: file does not exist"
line="status ok"
prompt="% "
send="bind /nothing /n; echo 'bind='$status; echo ok; echo 'after='$status"
line="bind=file does not exist"
line="ok"
line="after="
prompt="% "
send="mount /srv/bootfs /n; ls /n; ns | tail -1"
line="adm  bin  boot  dev  dist  lib  n  net  proc  rc  srv  sys  tmp"
line="mount /srv/bootfs /n"
fail="vx: panic"
fail="FAILED"
fail="not found"
fail="cannot"
