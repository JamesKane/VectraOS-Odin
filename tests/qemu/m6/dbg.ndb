# tests/qemu/dbg.ndb: M4's exit test, the debugger's part (05 §7, §5). dbg -c
# launches dbgdemo with a breakpoint in leaf: it stops there, prints the call
# stack with functions and lines and the variables at a frame, continues to
# the third call, where the program faults; the fault stops it first, then
# goes on to procfs, which saves the crash directory, and dbg prints the dead
# program's stack and variables from it.

scenario=dbg timeout=60 with=dbgdemo cmdline=vx.skip=rc
expect="dbg: /boot/bin/dbgdemo: "
expect="dbg: breakpoint at 0x"
expect="dbg: stopped: break at leaf (tests/user/dbgdemo.c:"
expect="*#0 0x"
expect=" in middle (tests/user/dbgdemo.c:"
expect=" in vx_main (tests/user/dbgdemo.c:"
line="= 1"
expect="label = 0x"
line="= 2"
expect=" #1 in middle (tests/user/dbgdemo.c:"
line="= 30"
expect="dbg: stopped: fault addr=0x10 at leaf (tests/user/dbgdemo.c:"
expect=" in middle (tests/user/dbgdemo.c:"
expect="procfs: dbgdemo."
expect="dbg: dbgdemo exited: sys: trap: fault read addr=0x10"
expect="dbg: crash directory /tmp/crash/dbgdemo."
expect="*#0 0x"
expect=" in middle (tests/user/dbgdemo.c:"
line="= 3"
line="= 6"
line="svcd: dbgdemo exited"
fail="vx: panic"
fail="svcd: dbgdemo exited: "
fail=") killed: "
fail="dbg: cannot"
