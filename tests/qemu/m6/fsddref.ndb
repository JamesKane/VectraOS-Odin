# tests/qemu/fsddref.ndb: 9Px's dref extension on fsd (M5 step 5d). The fsd
# scenarios' volume (tests/user/fsdvol.ndb), and dreftest (tests/user/dreftest.c),
# which reads and writes through VMOs of its own.

scenario=fsddref timeout=60 cmdline=vx.skip=rc with=dreftest,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="dreftest: 19 checks, 0 failed"
line="svcd: dreftest exited"
fail="vx: panic"
fail="dreftest: FAILED"
fail="svcd: dreftest exited: "
fail="fsd: FAILED"
fail=") killed: "
