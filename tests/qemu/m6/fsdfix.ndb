# tests/qemu/fsdfix.ndb: fsd's review findings fixed in M6 step 6d5c:
# status copies, ctl and status kept made up, the
# whole dump view, snapshot slots held by fids, users kept in their places,
# no reaping after halt (tests/user/fsdfix.c).

scenario=fsdfix timeout=300 cmdline=vx.skip=rc with=fsdfix,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="fsdfix: 34 checks, 0 failed"
line="svcd: fsdfix exited"
fail="vx: panic"
fail="fsdfix: FAILED"
fail="svcd: fsdfix exited: "
fail="fsd: FAILED"
fail=") killed: "
