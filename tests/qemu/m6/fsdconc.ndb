# tests/qemu/fsdconc.ndb: fsd's readers with the server let go (M6 step
# 6d5b): four reader threads checking every byte, one file larger than the
# block cache, a writer making, removing and committing meanwhile, more than
# one fsd thread, and a clean check after (tests/user/fsdconc.c).

scenario=fsdconc timeout=300 cmdline=vx.skip=rc with=fsdconc,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="fsdconc: 28 checks, 0 failed"
line="svcd: fsdconc exited"
fail="vx: panic"
fail="fsdconc: FAILED"
fail="svcd: fsdconc exited: "
fail="fsd: FAILED"
fail=") killed: "
