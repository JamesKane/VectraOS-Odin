# tests/qemu/fsddump.ndb: fsd's read-only snapshots and its dump view (M5 step
# 4b3). The fsd scenarios' volume (tests/user/fsdvol.ndb), and a script run as
# vectra (tests/user/fsddump.rc) that makes dated snapshots and reads them
# back through /n/YYYY/MMDD/home, and mounts one by its label.

scenario=fsddump timeout=60 cmdline=vx.skip=rc with=fsddump,fsdvol disk=64 volume=tests/fsd/home
expect="fsd: serving /srv/fsd"
expect="fsddump: 14 checks, 0 failed"
line="svcd: fsddump exited"
fail="vx: panic"
fail="fsddump: FAILED"
fail="svcd: fsddump exited: "
fail="fsd: FAILED"
fail=") killed: "
