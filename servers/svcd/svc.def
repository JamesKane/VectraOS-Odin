// The keys of a service manifest, svc(6).
// KEY(scope, key): scope is the node of the format's page that defines the key, or ""
// for the page itself; ./build man --check holds the page to this list, and
// the parser refuses any other key (vx_ndb_unknown).

KEY("service", "service")
KEY("service", "program")
KEY("service", "post")
KEY("service", "arch")
KEY("service", "when")
KEY("service", "restart")
KEY("service", "console")
KEY("service", "bootimage")
KEY("service", "storeimage")
KEY("service", "resource")
KEY("service", "pager")
KEY("service", "acpi")
KEY("service", "tasks")
KEY("service", "cmdline")
KEY("service", "entropy")
KEY("records", "arg")
KEY("records", "env")
KEY("records", "user")
KEY("records", "ns")
KEY("records", "mount")
KEY("records", "srv")
KEY("records", "aname")
KEY("records", "flags")
KEY("records", "bind")
KEY("records", "new")
KEY("records", "connect")
KEY("records", "claim")
KEY("records", "ioport")
KEY("records", "count")
KEY("records", "mmio")
KEY("records", "size")
KEY("records", "irq")
KEY("records", "part")
KEY("records", "type")
KEY("records", "name")
