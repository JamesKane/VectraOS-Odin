# ports/sbase/port.ndb: how tools/build builds sbase's commands (ADR-0010),
# for /boot/bin/posix, which the POSIX namespace template binds before
# /boot/bin, as Plan 9's APE binds /bin/ape: POSIX programs get sbase's ls and
# the rest, native ones the first-party commands of the same names.
#
# The flags are sbase's Makefile's CPPFLAGS (PREFIX in config.h, as /boot)
# with -std=c99 -O2, frame pointers kept as for musl (ADR-0007), and the
# include path for the generated files. sources= is LIBUTFOBJ and LIBUTILOBJ,
# archived (archive=); each program= is one of BIN, from its own .c as the
# Makefile's .c rule has it, and make from MAKEOBJ. They are linked into one
# binary, as the Makefile's sbase-box target does (box=): each program's main
# renamed NAME_main by -D on its command line rather than by mkbox's copies,
# and a main build generates choosing the program by argv[0] ("[" is test's).
# The image is to hold sbase-box once, and each name as a hard link to it:
# 100 static programs would each carry the C library. make is linked alone
# (alone=), as mkbox leaves it out: its globals clash with bc's and libutil's.
#
# A source under ports/ is generated, once, when sbase was vendored, as the
# Makefile would make it: bc.c by yacc (bison -y, 3.8.2) from bc.y, and
# getconf.h by scripts/getconf.sh. install= names files of the tree for the
# image, under /boot: bc -l's library, where PREFIX says. dir= is the
# directory under bin/ the programs go in.

port=sbase src=third_party/sbase archive=yes box=sbase-box box.alias=[ dir=posix install=bc.library:share/misc/bc.library
    cflags="-std=c99 -O2 -fno-omit-frame-pointer -D_DEFAULT_SOURCE -D_NETBSD_SOURCE -D_BSD_SOURCE -D_XOPEN_SOURCE=700 -D_FILE_OFFSET_BITS=64 -Ithird_party/sbase -Iports/sbase/generated -include ports/sbase/config.h"
    sources="libutf/fgetrune.c libutf/fputrune.c libutf/isalnumrune.c libutf/isalpharune.c libutf/isblankrune.c libutf/iscntrlrune.c libutf/isdigitrune.c libutf/isgraphrune.c libutf/isprintrune.c libutf/ispunctrune.c libutf/isspacerune.c libutf/istitlerune.c libutf/isxdigitrune.c libutf/lowerrune.c libutf/rune.c libutf/runetype.c libutf/upperrune.c libutf/utf.c libutf/utftorunestr.c libutil/concat.c libutil/cp.c libutil/crypt.c libutil/confirm.c libutil/ealloc.c libutil/enmasse.c libutil/eprintf.c libutil/eregcomp.c libutil/estrtod.c libutil/fnck.c libutil/fshut.c libutil/getlines.c libutil/human.c libutil/linecmp.c libutil/md5.c libutil/memmem.c libutil/mkdirp.c libutil/mode.c libutil/parseoffset.c libutil/putword.c libutil/reallocarray.c libutil/recurse.c libutil/rm.c libutil/sha1.c libutil/sha224.c libutil/sha256.c libutil/sha384.c libutil/sha512.c libutil/sha512-224.c libutil/sha512-256.c libutil/strcasestr.c libutil/strlcat.c libutil/strlcpy.c libutil/strsep.c libutil/strnsubst.c libutil/strtonum.c libutil/unescape.c libutil/writeall.c"

