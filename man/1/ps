id=3 pid=3 name=bootfs state=waiting threads=1 mem=31336K sid=3
id=2 pid=2 name=uart state=running threads=1 mem=8784K sid=2
id=4 pid=4 name=devmgr state=waiting threads=1 mem=5084K sid=4
id=5 pid=5 name=netd state=waiting threads=1 mem=9996K sid=5
id=6 pid=6 name=nsd state=waiting threads=1 mem=840K sid=6
id=7 pid=7 name=nullfs state=waiting threads=1 mem=1764K sid=7
id=8 pid=8 name=procfs state=running threads=1 mem=9900K sid=8
id=9 pid=9 name=ptyd state=waiting threads=1 mem=3080K sid=9
