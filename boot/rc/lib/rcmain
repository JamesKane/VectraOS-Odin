# /rc/lib/rcmain: rc's start, as 9front's rcmain.plan9 (rc(1); M6 step
# 6a6b). rc runs it first, with -bq and its own arguments; rc -m names another.
# VectraOS has no /env device, so a parent's exported functions come with
# the environment instead (M6 step 6a6c), and there is no loop over /env/fn#*.

if(~ $#home 0) home=/
if(~ $#ifs 0) ifs=' 	
'
switch($#prompt){
case 0
	prompt=('% ' '	')
case 1
	prompt=($prompt '	')
}
if(~ $rcname ?.out) prompt=('broken! ' '	')
if(flag p) path=/bin
if not{
	if(~ $#path 0) path=(/bin .)
}
fn sigexit
if(! ~ $#cflag 0){
	if(flag l){
		. -q /rc/lib/rcmain.local
		. -q $home/lib/profile
	}
	status=''
	eval $cflag
}
if not if(flag i){
	if(flag l){
		. -q /rc/lib/rcmain.local
		. -q $home/lib/profile
	}
	status=''
	if(! ~ $#* 0) . $*
	. -i '#d/0'
}
if not if(~ $#* 0) . '#d/0'
if not{
	status=''
	. $*
}
