# boot/svc/env.ndb: environment groups (servers/envd, M6 step 6e1c1,
# ADR-0044), posted as /srv/env: a process reaches its group through a
# connection of its own (vx-ns's /env), from the connector "srv:env" a
# manifest's connect=env gives and each parent passes to its children.
# entropy: the seed its groups' tokens come from.

service=envd program=/boot/bin/envd post=env console entropy restart
