#!/bin/sh
# ./build: makes abi/vx/abi_gen.odin from the ABI tables, and each format's
# NAME_keys_gen.odin from its key table, NAME.def (tools/abigen); compiles the
# build tool (tools/build) when their sources change; then runs it from the
# repository root. See tools/build/main.odin.
set -eu
cd "$(dirname "$0")"
ODIN=/opt/odin/odin # the pinned build (ADR-0001), on every host: Homebrew's odin moves with its releases
mkdir -p out/bin
gen=abi/vx/abi_gen.odin
stale=
[ -f "$gen" ] || stale=1
# The key tables: .def files of KEY lines in a package of lib, servers, cmd or drivers.
for def in $(find lib servers cmd drivers -mindepth 2 -maxdepth 2 -name '*.def' 2>/dev/null); do
  if grep -q '^KEY(' "$def" && [ ! -f "${def%.def}_keys_gen.odin" ]; then stale=1; fi
done
if [ -z "$stale" ] && [ -n "$(find abi/vx tools/abigen -newer "$gen" \( -name '*.def' -o -name '*.odin' \) ! -name abi_gen.odin 2>/dev/null | head -1)$(find lib servers cmd drivers -mindepth 2 -maxdepth 2 -newer "$gen" -name '*.def' 2>/dev/null | head -1)" ]; then
  stale=1
fi
if [ -n "$stale" ]; then
  "$ODIN" build tools/abigen -vet -strict-style -warnings-as-errors -out:out/bin/abigen
  out/bin/abigen
fi
tool=out/bin/build
if [ ! -x "$tool" ] || [ -n "$(find tools/build lib abi -newer "$tool" -name '*.odin' 2>/dev/null | head -1)" ]; then
  # Optimised: the manual's pass (./build man --check) has a 200 ms budget, as
  # upstream's, and unoptimised it takes some 175 ms on a quiet machine, 90 ms
  # so; the cost is some 5 s each time the tool is rebuilt.
  "$ODIN" build tools/build -collection:vx=lib -collection:abi=abi -vet -strict-style -warnings-as-errors -o:speed -out:"$tool"
fi
exec "$tool" "$@"
