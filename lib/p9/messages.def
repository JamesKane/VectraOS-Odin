// The 9P2000 messages (docs/02 §3): name, type number, and fields in wire
// order. The codec, the message names and the server's dispatch all expand
// from this table. 9Px's extensions add rows when their first user lands
// (02 §3.3). Terror (106) does not exist.

// 9P2000.L's, unchanged on the wire, for the posix and xattr extensions
// (docs/proto/posix.md). A server answers them only once one is negotiated.
P9_MSG(Rlerror,    7, P9F_ECODE)                            // 9P2000.L's errors (6d4c2)
P9_MSG(Tstatfs,    8, P9F_FID)
P9_MSG(Rstatfs,    9, P9F_STATFS)
P9_MSG(Tlopen,    12, P9F_FID, P9F_LFLAGS)
P9_MSG(Rlopen,    13, P9F_QID, P9F_IOUNIT)
P9_MSG(Tlcreate,  14, P9F_FID, P9F_NAME, P9F_LFLAGS, P9F_LMODE, P9F_GID)
P9_MSG(Rlcreate,  15, P9F_QID, P9F_IOUNIT)
P9_MSG(Tsymlink,  16, P9F_FID, P9F_NAME, P9F_NAME2, P9F_GID)
P9_MSG(Rsymlink,  17, P9F_QID)
P9_MSG(Treadlink, 22, P9F_FID)
P9_MSG(Rreadlink, 23, P9F_NAME2)
P9_MSG(Trename,   20, P9F_FID, P9F_NEWFID, P9F_NAME)            // fid, dfid, name (9P2000.L)
P9_MSG(Rrename,   21)
P9_MSG(Tgetattr,  24, P9F_FID, P9F_MASK)
P9_MSG(Rgetattr,  25, P9F_ATTR)
P9_MSG(Tsetattr,  26, P9F_FID, P9F_SETATTR)
P9_MSG(Rsetattr,  27)
P9_MSG(Tfsync,    50, P9F_FID, P9F_DATASYNC)
P9_MSG(Rfsync,    51)
P9_MSG(Treaddir,  40, P9F_FID, P9F_OFFSET, P9F_COUNT)           // 9P2000.L: entries from a cookie
P9_MSG(Rreaddir,  41, P9F_DATA)
P9_MSG(Tmkdir,    72, P9F_FID, P9F_NAME, P9F_LMODE, P9F_GID)
P9_MSG(Rmkdir,    73, P9F_QID)
P9_MSG(Tunlinkat, 76, P9F_FID, P9F_NAME, P9F_LFLAGS)
P9_MSG(Runlinkat, 77)
P9_MSG(Tlink,     70, P9F_FID, P9F_NEWFID, P9F_NAME)            // dfid, fid, name
P9_MSG(Rlink,     71)
P9_MSG(Trenameat, 74, P9F_FID, P9F_NAME, P9F_NEWFID, P9F_NAME2) // olddirfid, oldname, newdirfid, newname
P9_MSG(Rrenameat, 75)
P9_MSG(Tlock,     52, P9F_FID, P9F_LOCKTYPE, P9F_LOCKFLAGS, P9F_START, P9F_LENGTH, P9F_PROCID, P9F_CLIENTID)
P9_MSG(Rlock,     53, P9F_STATUS)
P9_MSG(Tgetlock,  54, P9F_FID, P9F_LOCKTYPE, P9F_START, P9F_LENGTH, P9F_PROCID, P9F_CLIENTID)
P9_MSG(Rgetlock,  55, P9F_LOCKTYPE, P9F_START, P9F_LENGTH, P9F_PROCID, P9F_CLIENTID)

// 9Px's own, for posix: open files shared between connections, and their
// offsets kept by the server (docs/proto/posix.md).
P9_MSG(Tshare,   150, P9F_FID, P9F_HOLDS)
P9_MSG(Rshare,   151, P9F_TOKEN)
P9_MSG(Tjoin,    152, P9F_NEWFID, P9F_TOKEN)
P9_MSG(Rjoin,    153, P9F_QID, P9F_IOUNIT)
P9_MSG(Tseek,    154, P9F_FID, P9F_OFFSET, P9F_WHENCE)
P9_MSG(Rseek,    155, P9F_OFFSET)
P9_MSG(Tdesc,    156, P9F_FID, P9F_DESCFLAGS)
P9_MSG(Rdesc,    157)

// 9Px's map extension (docs/proto/map.md): a file's range as a VMO, which
// comes back in one of the transport's handle slots.
P9_MSG(Tmap,     158, P9F_FID, P9F_OFFSET, P9F_LENGTH, P9F_PROT)
P9_MSG(Rmap,     159, P9F_OFFSET, P9F_LENGTH) // where in the VMO the range starts, and how much is there

// 9Px's dref extension (docs/proto/dref.md): a read or write whose data is
// in a VMO of the client's, which comes in one of the transport's handle
// slots, not in the message.
P9_MSG(Treadref,  160, P9F_FID, P9F_OFFSET, P9F_COUNT, P9F_ROFFSET)
P9_MSG(Rreadref,  161, P9F_COUNT)
P9_MSG(Twriteref, 162, P9F_FID, P9F_OFFSET, P9F_COUNT, P9F_ROFFSET)
P9_MSG(Rwriteref, 163, P9F_COUNT)

P9_MSG(Tversion, 100, P9F_MSIZE, P9F_VERSION)
P9_MSG(Rversion, 101, P9F_MSIZE, P9F_VERSION)
P9_MSG(Tauth,    102, P9F_AFID, P9F_UNAME, P9F_ANAME, P9F_NUNAME)
P9_MSG(Rauth,    103, P9F_QID)
P9_MSG(Tattach,  104, P9F_FID, P9F_AFID, P9F_UNAME, P9F_ANAME, P9F_NUNAME)
P9_MSG(Rattach,  105, P9F_QID)
P9_MSG(Rerror,   107, P9F_ENAME)
P9_MSG(Tflush,   108, P9F_OLDTAG)
P9_MSG(Rflush,   109)
P9_MSG(Twalk,    110, P9F_FID, P9F_NEWFID, P9F_WNAMES)
P9_MSG(Rwalk,    111, P9F_WQIDS)
P9_MSG(Topen,    112, P9F_FID, P9F_MODE)
P9_MSG(Ropen,    113, P9F_QID, P9F_IOUNIT)
P9_MSG(Tcreate,  114, P9F_FID, P9F_NAME, P9F_PERM, P9F_MODE)
P9_MSG(Rcreate,  115, P9F_QID, P9F_IOUNIT)
P9_MSG(Tread,    116, P9F_FID, P9F_OFFSET, P9F_COUNT)
P9_MSG(Rread,    117, P9F_DATA)
P9_MSG(Twrite,   118, P9F_FID, P9F_OFFSET, P9F_DATA)
P9_MSG(Rwrite,   119, P9F_COUNT)
P9_MSG(Tclunk,   120, P9F_FID)
P9_MSG(Rclunk,   121)
P9_MSG(Tremove,  122, P9F_FID)
P9_MSG(Rremove,  123)
P9_MSG(Tstat,    124, P9F_FID)
P9_MSG(Rstat,    125, P9F_STAT)
P9_MSG(Twstat,   126, P9F_FID, P9F_STAT)
P9_MSG(Rwstat,   127)
