// The fields 9P2000 messages are made of: name, wire kind, and the p9_msg
// member that holds it (messages.def says which message has which).

P9_FIELD(FID,     U32,    fid)
P9_FIELD(NEWFID,  U32,    newfid)
P9_FIELD(AFID,    U32,    afid)
P9_FIELD(MSIZE,   U32,    msize)
P9_FIELD(IOUNIT,  U32,    iounit)
P9_FIELD(PERM,    U32,    perm)
P9_FIELD(COUNT,   U32,    count)
P9_FIELD(OFFSET,  U64,    offset)
P9_FIELD(MODE,    U8,     mode)
P9_FIELD(OLDTAG,  U16,    oldtag)
P9_FIELD(VERSION, STR,    version)
P9_FIELD(UNAME,   STR,    uname)
P9_FIELD(ANAME,   STR,    aname)
P9_FIELD(ENAME,   STR,    ename)
P9_FIELD(NAME,    STR,    name)
P9_FIELD(QID,     QID,    qid)
P9_FIELD(WNAMES,  WNAMES, wname)   // nwname[2], then nwname strings
P9_FIELD(WQIDS,   WQIDS,  wqid)    // nwqid[2], then nwqid qids
P9_FIELD(DATA,    DATA,   data)    // count[4], then count bytes (count is set too)
P9_FIELD(STAT,    STAT,   stat)    // n[2], then n bytes of stat
// 9P2000.L's, for the posix and xattr extensions (02 §3.3, docs/proto/posix.md)
P9_FIELD(NAME2,   STR,    name2)   // a second name: Trenameat's new one, Tsymlink's target, Rreadlink's
P9_FIELD(GID,     U32,    gid)
P9_FIELD(MASK,    U64,    mask)    // Tgetattr's request_mask
P9_FIELD(DATASYNC, U32,   datasync)
P9_FIELD(ATTR,    ATTR,   attr)    // Rgetattr's body, valid[8] first
P9_FIELD(SETATTR, SETATTR, setattr) // Tsetattr's body, valid[4] first
P9_FIELD(LOCKTYPE, U8,    lock_type)  // Tlock's and Tgetlock's: read 0, write 1, unlock 2
P9_FIELD(LOCKFLAGS, U32,  lock_flags) // Tlock's: block 1, reclaim 2
P9_FIELD(START,   U64,    start)
P9_FIELD(LENGTH,  U64,    length)     // 0: to the end of the file
P9_FIELD(PROCID,  U32,    proc_id)
P9_FIELD(CLIENTID, STR,   client_id)
P9_FIELD(STATUS,  U8,     status)     // Rlock's: success 0, blocked 1, error 2
// 9Px's own, for posix (docs/proto/posix.md)
P9_FIELD(HOLDS,   U32,    holds)      // Tshare's: joins to keep the open file for
P9_FIELD(TOKEN,   TOKEN,  token)      // 16 bytes
P9_FIELD(WHENCE,  U8,     whence)     // Tseek's: set 0, current 1, end 2
P9_FIELD(DESCFLAGS, U32,  desc_flags) // Tdesc's: append 1
// 9Px's map extension (docs/proto/map.md)
P9_FIELD(PROT,    U32,    prot)       // Tmap's: read 1, write 2, exec 4
// 9Px's dref extension (docs/proto/dref.md)
P9_FIELD(ROFFSET, U64,    roffset)    // where in the request's VMO the data is, or goes
// 9P2000.L's (M6 step 6d4c2), as Linux's net/9p has them:
P9_FIELD(LFLAGS,  U32,    lflags)     // Tlopen's and Tlcreate's Linux open flags; Tunlinkat's AT_REMOVEDIR
P9_FIELD(LMODE,   U32,    lmode)      // Tlcreate's and Tmkdir's POSIX mode
P9_FIELD(ECODE,   U32,    ecode)      // Rlerror's Linux errno
P9_FIELD(NUNAME,  NUNAME, n_uname)    // Tattach's and Tauth's in .L and .u: there if has_n_uname, read if bytes remain
P9_FIELD(STATFS,  STATFS, statfs)     // Rstatfs's body
